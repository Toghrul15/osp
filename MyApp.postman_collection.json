{
  "info": {
    "name": "MyApp - Online Shopping API",
    "description": "Phase 1 (auth), F1 (catalog), F6 (search), F2 (cart), F4 addresses and F3 (orders). Run 'Auth > Login as admin' first: it stores the token used by all admin requests. Create requests store the new id in a collection variable, so later requests use it automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5127" },
    { "key": "adminToken", "value": "" },
    { "key": "customerToken", "value": "" },
    { "key": "categoryId", "value": "" },
    { "key": "subcategoryId", "value": "" },
    { "key": "tagId", "value": "" },
    { "key": "productId", "value": "" },
    { "key": "imageId", "value": "" },
    { "key": "addressId", "value": "" },
    { "key": "orderId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register customer",
          "event": [{ "listen": "test", "script": { "exec": [
            "if (pm.response.code === 200) pm.collectionVariables.set('customerToken', pm.response.json().accessToken);"
          ] } }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/register",
            "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Test Customer\",\n  \"email\": \"customer1@myapp.local\",\n  \"password\": \"Customer123!\"\n}" },
            "description": "200 with a token. 409 if the email is already registered: then use 'Login as customer'."
          }
        },
        {
          "name": "Login as customer",
          "event": [{ "listen": "test", "script": { "exec": [
            "if (pm.response.code === 200) pm.collectionVariables.set('customerToken', pm.response.json().accessToken);"
          ] } }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"customer1@myapp.local\",\n  \"password\": \"Customer123!\"\n}" }
          }
        },
        {
          "name": "Login as admin",
          "event": [{ "listen": "test", "script": { "exec": [
            "if (pm.response.code === 200) pm.collectionVariables.set('adminToken', pm.response.json().accessToken);"
          ] } }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@myapp.local\",\n  \"password\": \"Admin123!\"\n}" },
            "description": "Seeded admin from SeedAdmin:* in appsettings.Development.json."
          }
        },
        {
          "name": "Me (current user)",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/auth/me" }
        }
      ]
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "Get category tree (public)",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{baseUrl}}/api/categories" }
        },
        {
          "name": "Create category (admin)",
          "event": [{ "listen": "test", "script": { "exec": [
            "if (pm.response.code === 201) pm.collectionVariables.set('categoryId', pm.response.json().id);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/categories",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Electronics\",\n  \"description\": \"Phones, laptops and accessories\"\n}" },
            "description": "201. 409 if a category with the same name already exists."
          }
        },
        {
          "name": "Create subcategory (admin)",
          "event": [{ "listen": "test", "script": { "exec": [
            "if (pm.response.code === 201) pm.collectionVariables.set('subcategoryId', pm.response.json().id);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/categories",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Phones\",\n  \"parentCategoryId\": {{categoryId}}\n}" }
          }
        },
        {
          "name": "Get category by id (public)",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{baseUrl}}/api/categories/{{categoryId}}" }
        },
        {
          "name": "Update category (admin)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/categories/{{subcategoryId}}",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Smartphones\",\n  \"description\": \"Renamed\",\n  \"parentCategoryId\": {{categoryId}}\n}" },
            "description": "400 if the parent would create a cycle (a category under its own subcategory)."
          }
        },
        {
          "name": "Create category as customer (expect 403)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{customerToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/categories",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Not allowed\"\n}" }
          }
        },
        {
          "name": "Delete category (admin)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/categories/{{subcategoryId}}",
            "description": "204. 409 while it still has products or subcategories."
          }
        }
      ]
    },
    {
      "name": "Tags",
      "item": [
        {
          "name": "Get all tags (public)",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{baseUrl}}/api/tags" }
        },
        {
          "name": "Create tag (admin)",
          "event": [{ "listen": "test", "script": { "exec": [
            "if (pm.response.code === 201) pm.collectionVariables.set('tagId', pm.response.json().id);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/tags",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"New arrival\"\n}" }
          }
        },
        {
          "name": "Get tag by id (public)",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{baseUrl}}/api/tags/{{tagId}}" }
        },
        {
          "name": "Delete tag (admin)",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/tags/{{tagId}}" }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "Create product (admin/vendor)",
          "event": [{ "listen": "test", "script": { "exec": [
            "if (pm.response.code === 201) pm.collectionVariables.set('productId', pm.response.json().id);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/products",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Phone X\",\n  \"description\": \"6.1 inch screen, 128 GB\",\n  \"price\": 499.99,\n  \"stockQuantity\": 25,\n  \"categoryId\": {{subcategoryId}},\n  \"tagIds\": [{{tagId}}],\n  \"isActive\": true\n}" },
            "description": "400 if the category or a tag doesn't exist, or price/stock is negative."
          }
        },
        {
          "name": "Get products (public, paged)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/products?page=1&pageSize=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Get products by category (public)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/products?categoryId={{categoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"],
              "query": [{ "key": "categoryId", "value": "{{categoryId}}" }]
            },
            "description": "Includes products in all subcategories of this category."
          }
        },
        {
          "name": "Search products - all filters (public)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/products?search=phone&minPrice=100&maxPrice=1000&sort=priceAsc&page=1&pageSize=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"],
              "query": [
                { "key": "search", "value": "phone", "description": "Matches name or description, case-insensitive" },
                { "key": "categoryId", "value": "{{categoryId}}", "description": "Includes subcategories", "disabled": true },
                { "key": "tagId", "value": "{{tagId}}", "disabled": true },
                { "key": "minPrice", "value": "100" },
                { "key": "maxPrice", "value": "1000", "description": "400 if minPrice > maxPrice" },
                { "key": "minRating", "value": "4", "description": "0-5", "disabled": true },
                { "key": "inStock", "value": "true", "description": "true = stock > 0, false = sold out", "disabled": true },
                { "key": "sort", "value": "priceAsc", "description": "newest (default), priceAsc, priceDesc, rating, name" },
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20", "description": "1-100" }
              ]
            },
            "description": "Tick or untick query params in the Params tab to combine filters."
          }
        },
        {
          "name": "Search products - text only (public)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/products?search=phone",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"],
              "query": [{ "key": "search", "value": "phone" }]
            }
          }
        },
        {
          "name": "Search products - in stock, top rated (public)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/products?inStock=true&sort=rating",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"],
              "query": [
                { "key": "inStock", "value": "true" },
                { "key": "sort", "value": "rating" }
              ]
            }
          }
        },
        {
          "name": "Search products - invalid price range (expect 400)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/products?minPrice=500&maxPrice=100",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"],
              "query": [
                { "key": "minPrice", "value": "500" },
                { "key": "maxPrice", "value": "100" }
              ]
            }
          }
        },
        {
          "name": "Get product by id (public)",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{baseUrl}}/api/products/{{productId}}" }
        },
        {
          "name": "Update product (admin/vendor)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/products/{{productId}}",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Phone X Pro\",\n  \"description\": \"6.1 inch screen, 256 GB\",\n  \"price\": 599.99,\n  \"stockQuantity\": 20,\n  \"categoryId\": {{subcategoryId}},\n  \"tagIds\": [],\n  \"isActive\": true\n}" },
            "description": "Replaces all fields, including the tag list."
          }
        },
        {
          "name": "Update stock (admin/vendor)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/products/{{productId}}/stock",
            "body": { "mode": "raw", "raw": "{\n  \"quantity\": 10\n}" }
          }
        },
        {
          "name": "Upload image (admin/vendor)",
          "event": [{ "listen": "test", "script": { "exec": [
            "if (pm.response.code === 201) pm.collectionVariables.set('imageId', pm.response.json().id);"
          ] } }],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/products/{{productId}}/images",
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "file", "type": "file", "src": [] }]
            },
            "description": "In the Body tab, choose a .jpg/.png/.webp file (max 5 MB) for the 'file' key. The response url can be opened at {{baseUrl}}<url>."
          }
        },
        {
          "name": "Set main image (admin/vendor)",
          "request": { "method": "PUT", "url": "{{baseUrl}}/api/products/{{productId}}/images/{{imageId}}/main" }
        },
        {
          "name": "Delete image (admin/vendor)",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/products/{{productId}}/images/{{imageId}}" }
        },
        {
          "name": "Delete product (soft, admin/vendor)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/products/{{productId}}",
            "description": "Hides the product: it disappears from the list and its details return 404."
          }
        }
      ]
    },
    {
      "name": "Cart",
      "description": "Every request uses the customer token: run 'Auth > Register customer' or 'Login as customer' first. Uses {{productId}} from 'Products > Create product' (don't delete that product first). Every request returns the whole cart with a summary.",
      "auth": {
        "type": "bearer",
        "bearer": [{ "key": "token", "value": "{{customerToken}}", "type": "string" }]
      },
      "item": [
        {
          "name": "Get cart",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/cart" }
        },
        {
          "name": "Add item",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/cart/items",
            "body": { "mode": "raw", "raw": "{\n  \"productId\": {{productId}},\n  \"quantity\": 2\n}" },
            "description": "Adding a product that is already in the cart increases its quantity. 400 if over stock, out of stock, inactive, or quantity outside 1-99. 404 if the product doesn't exist."
          }
        },
        {
          "name": "Update item quantity",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/cart/items/{{productId}}",
            "body": { "mode": "raw", "raw": "{\n  \"quantity\": 1\n}" },
            "description": "Sets the quantity (1-99). 404 if the product isn't in the cart."
          }
        },
        {
          "name": "Add more than stock (expect 400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/cart/items",
            "body": { "mode": "raw", "raw": "{\n  \"productId\": {{productId}},\n  \"quantity\": 99\n}" }
          }
        },
        {
          "name": "Remove item",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/cart/items/{{productId}}" }
        },
        {
          "name": "Clear cart",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/cart" }
        },
        {
          "name": "Get cart without token (expect 401)",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{baseUrl}}/api/cart" }
        }
      ]
    },
    {
      "name": "Addresses",
      "description": "The customer's saved delivery addresses. Uses the customer token.",
      "auth": {
        "type": "bearer",
        "bearer": [{ "key": "token", "value": "{{customerToken}}", "type": "string" }]
      },
      "item": [
        {
          "name": "Add address",
          "event": [{ "listen": "test", "script": { "exec": [
            "if (pm.response.code === 201) pm.collectionVariables.set('addressId', pm.response.json().id);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/account/addresses",
            "body": { "mode": "raw", "raw": "{\n  \"recipientName\": \"Test Customer\",\n  \"phoneNumber\": \"+994 50 123 45 67\",\n  \"line1\": \"10 Nizami St\",\n  \"line2\": \"Apt 5\",\n  \"city\": \"Baku\",\n  \"postalCode\": \"AZ1000\",\n  \"country\": \"Azerbaijan\",\n  \"isDefault\": false\n}" },
            "description": "The first address becomes the default automatically. Max 10."
          }
        },
        {
          "name": "Get my addresses",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/account/addresses" }
        },
        {
          "name": "Get address",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/account/addresses/{{addressId}}" }
        },
        {
          "name": "Edit address",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/account/addresses/{{addressId}}",
            "body": { "mode": "raw", "raw": "{\n  \"recipientName\": \"Test Customer\",\n  \"phoneNumber\": \"+994 50 123 45 67\",\n  \"line1\": \"22 Fuzuli St\",\n  \"city\": \"Baku\",\n  \"postalCode\": \"AZ1001\",\n  \"country\": \"Azerbaijan\",\n  \"isDefault\": true\n}" }
          }
        },
        {
          "name": "Make default",
          "request": { "method": "PUT", "url": "{{baseUrl}}/api/account/addresses/{{addressId}}/default" }
        },
        {
          "name": "Delete address",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/account/addresses/{{addressId}}",
            "description": "Run this last: checkout needs {{addressId}}."
          }
        }
      ]
    },
    {
      "name": "Orders",
      "description": "Checkout and the customer's own orders. Uses the customer token. Before checkout: add something to the cart ('Cart > Add item') and save an address ('Addresses > Add address').",
      "auth": {
        "type": "bearer",
        "bearer": [{ "key": "token", "value": "{{customerToken}}", "type": "string" }]
      },
      "item": [
        {
          "name": "Checkout (place order)",
          "event": [{ "listen": "test", "script": { "exec": [
            "if (pm.response.code === 201) pm.collectionVariables.set('orderId', pm.response.json().id);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/orders",
            "body": { "mode": "raw", "raw": "{\n  \"addressId\": {{addressId}}\n}" },
            "description": "400 if the cart is empty or items are unavailable/over stock (see 'errors'). Decreases stock and empties the cart."
          }
        },
        {
          "name": "My orders",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/orders?page=1&pageSize=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" },
                { "key": "status", "value": "Pending", "description": "Pending, Processing, Shipped, Delivered, Cancelled", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get my order",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/orders/{{orderId}}" }
        },
        {
          "name": "Cancel my order (Pending only)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/orders/{{orderId}}/cancel",
            "body": { "mode": "raw", "raw": "{\n  \"reason\": \"Ordered by mistake\"\n}" },
            "description": "Puts the items back into stock. 400 once the order is Processing or later."
          }
        }
      ]
    },
    {
      "name": "Admin Orders",
      "description": "All orders and status changes. Uses the admin token. Status flow: Pending -> Processing -> Shipped -> Delivered; Pending/Processing -> Cancelled.",
      "item": [
        {
          "name": "All orders",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/admin/orders?page=1&pageSize=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "orders"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" },
                { "key": "status", "value": "Pending", "disabled": true },
                { "key": "search", "value": "ORD-", "description": "Order number, customer email or name", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get order",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/orders/{{orderId}}" }
        },
        {
          "name": "Status -> Processing",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/admin/orders/{{orderId}}/status",
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"Processing\",\n  \"note\": \"Packing your order\"\n}" }
          }
        },
        {
          "name": "Status -> Shipped",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/admin/orders/{{orderId}}/status",
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"Shipped\",\n  \"note\": \"Tracking number AZ123456\"\n}" }
          }
        },
        {
          "name": "Status -> Delivered",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/admin/orders/{{orderId}}/status",
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"Delivered\"\n}" },
            "description": "Also marks the payment as Paid."
          }
        },
        {
          "name": "Status -> Cancelled",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/admin/orders/{{orderId}}/status",
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"Cancelled\",\n  \"note\": \"Out of stock at the warehouse\"\n}" },
            "description": "Only from Pending or Processing. Puts the items back into stock."
          }
        },
        {
          "name": "Invalid move (expect 400)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/admin/orders/{{orderId}}/status",
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"Pending\"\n}" }
          }
        }
      ]
    }
  ]
}

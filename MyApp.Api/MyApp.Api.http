@MyApp.Api_HostAddress = http://localhost:5127

### Register a customer
POST {{MyApp.Api_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "fullName": "Test Customer",
  "email": "customer@myapp.local",
  "password": "Customer123!"
}

### Log in as the seeded admin
# @name login
POST {{MyApp.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@myapp.local",
  "password": "Admin123!"
}

### Current user (uses the token from the login request above)
GET {{MyApp.Api_HostAddress}}/api/auth/me
Authorization: Bearer {{login.response.body.$.accessToken}}

### ---------- Catalog (F1) ----------

### Create a category (admin)
# @name category
POST {{MyApp.Api_HostAddress}}/api/categories
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{
  "name": "Electronics",
  "description": "Phones, laptops and accessories"
}

### Create a subcategory (admin)
# @name subcategory
POST {{MyApp.Api_HostAddress}}/api/categories
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{
  "name": "Phones",
  "parentCategoryId": {{category.response.body.$.id}}
}

### Category tree (public)
GET {{MyApp.Api_HostAddress}}/api/categories

### Create a tag (admin)
# @name tag
POST {{MyApp.Api_HostAddress}}/api/tags
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{
  "name": "New arrival"
}

### Tags (public)
GET {{MyApp.Api_HostAddress}}/api/tags

### Create a product (admin or vendor)
# @name product
POST {{MyApp.Api_HostAddress}}/api/products
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{
  "name": "Phone X",
  "description": "6.1 inch screen, 128 GB",
  "price": 499.99,
  "stockQuantity": 25,
  "categoryId": {{subcategory.response.body.$.id}},
  "tagIds": [{{tag.response.body.$.id}}],
  "isActive": true
}

### Product list (public, paged; categoryId includes subcategories)
GET {{MyApp.Api_HostAddress}}/api/products?page=1&pageSize=20&categoryId={{category.response.body.$.id}}

### Search and filter products (public, F6)
# search: name or description; sort: newest | priceAsc | priceDesc | rating | name
# also: categoryId, tagId, minRating (0-5), inStock (true/false), page, pageSize
GET {{MyApp.Api_HostAddress}}/api/products?search=phone&minPrice=100&maxPrice=1000&inStock=true&sort=priceAsc

### Product details (public)
GET {{MyApp.Api_HostAddress}}/api/products/{{product.response.body.$.id}}

### Set stock
PATCH {{MyApp.Api_HostAddress}}/api/products/{{product.response.body.$.id}}/stock
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{
  "quantity": 10
}

### Upload an image (put a phone.jpg next to this file)
POST {{MyApp.Api_HostAddress}}/api/products/{{product.response.body.$.id}}/images
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="file"; filename="phone.jpg"
Content-Type: image/jpeg

< ./phone.jpg
--boundary--

### ---------- Cart (F2): uses the customer token ----------

### Log in as a customer (register first)
# @name customerLogin
POST {{MyApp.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "customer@myapp.local",
  "password": "Customer123!"
}

### Add to cart (adds to the quantity if already in the cart)
POST {{MyApp.Api_HostAddress}}/api/cart/items
Authorization: Bearer {{customerLogin.response.body.$.accessToken}}
Content-Type: application/json

{
  "productId": {{product.response.body.$.id}},
  "quantity": 2
}

### Get cart with price summary
GET {{MyApp.Api_HostAddress}}/api/cart
Authorization: Bearer {{customerLogin.response.body.$.accessToken}}

### Change quantity
PUT {{MyApp.Api_HostAddress}}/api/cart/items/{{product.response.body.$.id}}
Authorization: Bearer {{customerLogin.response.body.$.accessToken}}
Content-Type: application/json

{
  "quantity": 1
}

### Remove item
DELETE {{MyApp.Api_HostAddress}}/api/cart/items/{{product.response.body.$.id}}
Authorization: Bearer {{customerLogin.response.body.$.accessToken}}

### Clear cart
DELETE {{MyApp.Api_HostAddress}}/api/cart
Authorization: Bearer {{customerLogin.response.body.$.accessToken}}

### Soft-delete the product
DELETE {{MyApp.Api_HostAddress}}/api/products/{{product.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.accessToken}}

###
